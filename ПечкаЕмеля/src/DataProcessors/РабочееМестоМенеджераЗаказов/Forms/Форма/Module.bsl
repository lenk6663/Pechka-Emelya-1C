
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Объект.ДатаОтгрузки = НачалоДня(ТекущаяДатаСеанса()) + 86400;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаОтгрузкиПриИзменении(Элемент)

	ПересчитатьЦеныСостава();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТочки

&НаКлиенте
Процедура ТочкиПриАктивизацииСтроки(Элемент)

	УстановитьОтборСостава();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСостав

&НаКлиенте
Процедура СоставПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;

	ТекущаяТочка = Элементы.Точки.ТекущиеДанные;
	Если ТекущаяТочка <> Неопределено Тогда
		Элемент.ТекущиеДанные.Клиент = ТекущаяТочка.Клиент;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоставПродукцияПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	ТекущиеДанные.Цена = ЗаказыСервер.ЦенаПродукции(ТекущиеДанные.Клиент, ТекущиеДанные.Продукция, Объект.ДатаОтгрузки);
	Если ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;

КонецПроцедуры

&НаКлиенте
Процедура СоставКоличествоПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьТочки(Команда)

	Если Объект.Маршруты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Заполните список маршрутов.");
		Возврат;
	КонецЕсли;

	ЗаполнитьТочкиНаСервере();
	УстановитьОтборСостава();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоШаблону(Команда)

	Клиенты = КлиентыДляЗаполнения();
	Если Клиенты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте флажком торговые точки или выберите торговую точку в списке.");
		Возврат;
	КонецЕсли;

	ЗаполнитьПоШаблонуНаСервере(Клиенты);
	УстановитьОтборСостава();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКакВчера(Команда)

	Клиенты = КлиентыДляЗаполнения();
	Если Клиенты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте флажком торговые точки или выберите торговую точку в списке.");
		Возврат;
	КонецЕсли;

	ЗаполнитьКакВчераНаСервере(Клиенты);
	УстановитьОтборСостава();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявки(Команда)

	Создано = СоздатьЗаявкиНаСервере();
	УстановитьОтборСостава();
	ПоказатьОповещениеПользователя("Создание заказов клиентов", , СтрШаблон("Создано заказов: %1", Создано));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьОтборСостава()

	ТекущаяТочка = Элементы.Точки.ТекущиеДанные;
	Если ТекущаяТочка = Неопределено Тогда
		Элементы.Состав.ОтборСтрок = Новый ФиксированнаяСтруктура("Клиент",
			ПредопределенноеЗначение("Справочник.Клиенты.ПустаяСсылка"));
	Иначе
		Элементы.Состав.ОтборСтрок = Новый ФиксированнаяСтруктура("Клиент", ТекущаяТочка.Клиент);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция КлиентыДляЗаполнения()

	Клиенты = Новый Массив;
	Для Каждого Точка Из Объект.Точки Цикл
		Если Точка.Выбран Тогда
			Клиенты.Добавить(Точка.Клиент);
		КонецЕсли;
	КонецЦикла;

	Если Клиенты.Количество() = 0 И Элементы.Точки.ТекущиеДанные <> Неопределено Тогда
		Клиенты.Добавить(Элементы.Точки.ТекущиеДанные.Клиент);
	КонецЕсли;

	Возврат Клиенты;

КонецФункции

&НаСервере
Процедура ЗаполнитьТочкиНаСервере()

	Объект.Точки.Очистить();
	Объект.Состав.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Клиенты.Ссылка КАК Клиент
		|ИЗ
		|	Справочник.Клиенты КАК Клиенты
		|ГДЕ
		|	Клиенты.Район В (&Маршруты)
		|	И НЕ Клиенты.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Клиенты.Район.Наименование,
		|	Клиенты.Наименование";
	Запрос.УстановитьПараметр("Маршруты", Объект.Маршруты.Выгрузить().ВыгрузитьКолонку("Маршрут"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект.Точки.Добавить().Клиент = Выборка.Клиент;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоШаблонуНаСервере(Клиенты)

	УдалитьСоставКлиентов(Клиенты);
	ДобавитьВСостав(ЗаказыСервер.ДанныеШаблонов(Клиенты));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКакВчераНаСервере(Клиенты)

	УдалитьСоставКлиентов(Клиенты);
	ДобавитьВСостав(ЗаказыСервер.ДанныеЗаказовЗаВчера(Клиенты));

КонецПроцедуры

&НаСервере
Процедура УдалитьСоставКлиентов(Клиенты)

	Для Каждого Клиент Из Клиенты Цикл
		Строки = Объект.Состав.НайтиСтроки(Новый Структура("Клиент", Клиент));
		Для Каждого Строка Из Строки Цикл
			Объект.Состав.Удалить(Строка);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьВСостав(Данные)

	Для Каждого СтрокаДанных Из Данные Цикл
		НоваяСтрока = Объект.Состав.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		НоваяСтрока.Цена = ЗаказыСервер.ЦенаПродукции(НоваяСтрока.Клиент, НоваяСтрока.Продукция, Объект.ДатаОтгрузки);
		НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьЦеныСостава()

	Для Каждого Строка Из Объект.Состав Цикл
		Строка.Цена = ЗаказыСервер.ЦенаПродукции(Строка.Клиент, Строка.Продукция, Объект.ДатаОтгрузки);
		Строка.Сумма = Строка.Цена * Строка.Количество;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СоздатьЗаявкиНаСервере()

	Создано = 0;

	Для Каждого Точка Из Объект.Точки Цикл

		Если Не Точка.Выбран Тогда
			Продолжить;
		КонецЕсли;

		Строки = Объект.Состав.НайтиСтроки(Новый Структура("Клиент", Точка.Клиент));
		Если Строки.Количество() = 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Для торговой точки ""%1"" не заполнен состав заказа.", Точка.Клиент);
			Сообщение.Сообщить();
			Продолжить;
		КонецЕсли;

		Заказ = Документы.ЗаказКлиента.СоздатьДокумент();
		Заказ.Заполнить(Неопределено);
		Заказ.Дата = ТекущаяДатаСеанса();
		Заказ.Клиент = Точка.Клиент;
		Заказ.ДатаОтгрузки = Объект.ДатаОтгрузки;
		Для Каждого Строка Из Строки Цикл
			ЗаполнитьЗначенияСвойств(Заказ.Товары.Добавить(), Строка, "Продукция, Количество");
		КонецЦикла;
		Заказ.Записать();

		Для Каждого Строка Из Строки Цикл
			Объект.Состав.Удалить(Строка);
		КонецЦикла;
		Точка.Выбран = Ложь;
		Создано = Создано + 1;

	КонецЦикла;

	Возврат Создано;

КонецФункции

#КонецОбласти
