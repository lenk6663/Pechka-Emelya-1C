
#Область ПрограммныйИнтерфейс

// Цена продукции для клиента на дату (в рублях) по регистру "Цены продукции".
//
// Параметры:
//  Клиент - СправочникСсылка.Клиенты
//  Продукция - СправочникСсылка.ПродукцияИМатериалы
//  Дата - Дата
//
// Возвращаемое значение:
//  Число
//
Функция ЦенаПродукции(Клиент, Продукция, Знач Дата) Экспорт

	Если Не ЗначениеЗаполнено(Клиент) Или Не ЗначениеЗаполнено(Продукция) Тогда
		Возврат 0;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	// Цены доступны для изменения только администратору, но читать их нужно при оформлении заказов.
	УстановитьПривилегированныйРежим(Истина);

	Отбор = Новый Структура("Клиент, Продукция", Клиент, Продукция);
	Возврат РегистрыСведений.ЦеныПродукции.ПолучитьПоследнее(КонецДня(Дата), Отбор).Цена;

КонецФункции

// Заполняет цены и суммы в строках заказа по ценам клиента на дату отгрузки.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказКлиента - заказ или данные формы заказа
//
Процедура ЗаполнитьЦеныВЗаказе(Заказ) Экспорт

	Для Каждого СтрокаТоваров Из Заказ.Товары Цикл
		СтрокаТоваров.Цена = ЦенаПродукции(Заказ.Клиент, СтрокаТоваров.Продукция, Заказ.ДатаОтгрузки);
		СтрокаТоваров.Сумма = СтрокаТоваров.Цена * СтрокаТоваров.Количество;
	КонецЦикла;

	Заказ.СуммаДокумента = Заказ.Товары.Итог("Сумма");

КонецПроцедуры

// Состав шаблонов заказа для списка клиентов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Клиент, Продукция, Количество
//
Функция ДанныеШаблонов(Клиенты) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ШаблоныЗаказов.Клиент КАК Клиент,
		|	ШаблоныЗаказов.Продукция КАК Продукция,
		|	ШаблоныЗаказов.Количество КАК Количество
		|ИЗ
		|	РегистрСведений.ШаблоныЗаказов КАК ШаблоныЗаказов
		|ГДЕ
		|	ШаблоныЗаказов.Клиент В (&Клиенты)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ШаблоныЗаказов.Продукция.Наименование";
	Запрос.УстановитьПараметр("Клиенты", Клиенты);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Продукция, которую клиенты заказывали с отгрузкой за вчерашний день.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Клиент, Продукция, Количество
//
Функция ДанныеЗаказовЗаВчера(Клиенты) Экспорт

	Вчера = НачалоДня(ТекущаяДатаСеанса()) - 86400;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.Ссылка.Клиент КАК Клиент,
		|	ЗаказКлиентаТовары.Продукция КАК Продукция,
		|	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка.Клиент В (&Клиенты)
		|	И ЗаказКлиентаТовары.Ссылка.ДатаОтгрузки МЕЖДУ &Начало И &Конец
		|	И НЕ ЗаказКлиентаТовары.Ссылка.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаТовары.Ссылка.Клиент,
		|	ЗаказКлиентаТовары.Продукция
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказКлиентаТовары.Продукция.Наименование";
	Запрос.УстановитьПараметр("Клиенты", Клиенты);
	Запрос.УстановитьПараметр("Начало", НачалоДня(Вчера));
	Запрос.УстановитьПараметр("Конец", КонецДня(Вчера));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти
