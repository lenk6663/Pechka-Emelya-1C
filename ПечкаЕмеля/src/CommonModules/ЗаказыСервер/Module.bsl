
#Область ПрограммныйИнтерфейс

// Цена продукции для клиента на дату (в рублях) по регистру "Цены продукции".
//
// Параметры:
//  Клиент - СправочникСсылка.Клиенты
//  Продукция - СправочникСсылка.ПродукцияИМатериалы
//  Дата - Дата
//
// Возвращаемое значение:
//  Число
//
Функция ЦенаПродукции(Клиент, Продукция, Знач Дата) Экспорт

	Если Не ЗначениеЗаполнено(Клиент) Или Не ЗначениеЗаполнено(Продукция) Тогда
		Возврат 0;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	// Цены доступны для изменения только администратору, но читать их нужно при оформлении заказов.
	УстановитьПривилегированныйРежим(Истина);

	Отбор = Новый Структура("Клиент, Продукция", Клиент, Продукция);
	Возврат РегистрыСведений.ЦеныПродукции.ПолучитьПоследнее(КонецДня(Дата), Отбор).Цена;

КонецФункции

// Заполняет цены и суммы в строках заказа по ценам клиента на дату отгрузки.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказКлиента - заказ или данные формы заказа
//
Процедура ЗаполнитьЦеныВЗаказе(Заказ) Экспорт

	Для Каждого СтрокаТоваров Из Заказ.Товары Цикл
		СтрокаТоваров.Цена = ЦенаПродукции(Заказ.Клиент, СтрокаТоваров.Продукция, Заказ.ДатаОтгрузки);
		СтрокаТоваров.Сумма = СтрокаТоваров.Цена * СтрокаТоваров.Количество;
	КонецЦикла;

	Заказ.СуммаДокумента = Заказ.Товары.Итог("Сумма");

КонецПроцедуры

#КонецОбласти
