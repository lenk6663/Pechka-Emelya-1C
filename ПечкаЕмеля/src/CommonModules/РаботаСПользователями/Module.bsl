
#Область ПрограммныйИнтерфейс

// Вызывается из модуля сеанса. Если в информационной базе еще нет пользователей,
// создается служебный пользователь "Администратор", который не отображается в списке выбора.
// Пользователь, не зарегистрированный в справочнике сотрудников, в систему не допускается.
Процедура ПроверитьДоступПриНачалеСеанса() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() = 0 Тогда
		СоздатьСлужебногоАдминистратора();
		Возврат;
	КонецЕсли;

	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПустаяСтрока(ТекущийПользователь.Имя) Тогда
		Возврат;
	КонецЕсли;

	Если ТекущийПользователь.Роли.Содержит(Метаданные.Роли.Администратор) Тогда
		Возврат;
	КонецЕсли;

	Если ТекущийСотрудник().Пустая() Тогда
		ВызватьИсключение НСтр("ru = 'Пользователь не зарегистрирован в справочнике сотрудников. Доступ к системе не предоставляется.'");
	КонецЕсли;

КонецПроцедуры

// Возвращает сотрудника, связанного с текущим пользователем информационной базы.
//
// Возвращаемое значение:
//  СправочникСсылка.Сотрудники
//
Функция ТекущийСотрудник() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Сотрудники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.ИдентификаторПользователяИБ = &Идентификатор
		|	И НЕ Сотрудники.ПометкаУдаления";
	Запрос.УстановитьПараметр("Идентификатор", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Сотрудники.ПустаяСсылка();

КонецФункции

// Заголовок главного окна приложения.
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаголовокПриложения() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Наименование = Константы.НаименованиеПредприятия.Получить();
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = "Печка Емеля";
	КонецЕсли;

	ИмяПользователя = ПолноеИмяПользователя();
	Если ПустаяСтрока(ИмяПользователя) Тогда
		Возврат Наименование;
	КонецЕсли;

	Возврат СтрШаблон("%1 / %2", Наименование, ИмяПользователя);

КонецФункции

// Создает или обновляет пользователя информационной базы по данным сотрудника.
// Имя пользователя для входа - ФИО сотрудника, роль определяется уровнем доступа.
//
// Параметры:
//  Сотрудник - СправочникОбъект.Сотрудники
//  Отказ - Булево
//
Процедура ЗаписатьПользователяИБ(Сотрудник, Отказ) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ПользовательИБ = Неопределено;
	Если ЗначениеЗаполнено(Сотрудник.ИдентификаторПользователяИБ) Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Сотрудник.ИдентификаторПользователяИБ);
	КонецЕсли;
	Если ПользовательИБ = Неопределено Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Сотрудник.Наименование);
	КонецЕсли;
	Если ПользовательИБ = Неопределено Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
	КонецЕсли;

	ЭтоАдминистратор = (Сотрудник.УровеньДоступа = Перечисления.УровниДоступа.Администратор);

	ПользовательИБ.Имя = Сотрудник.Наименование;
	ПользовательИБ.ПолноеИмя = Сотрудник.Наименование;
	ПользовательИБ.АутентификацияСтандартная = Не Сотрудник.ПометкаУдаления;
	ПользовательИБ.ПоказыватьВСпискеВыбора = Не ЭтоАдминистратор И Не Сотрудник.ПометкаУдаления;
	ПользовательИБ.ЗапрещеноИзменятьПароль = Ложь;
	Если Не ПустаяСтрока(Сотрудник.Пароль) Тогда
		ПользовательИБ.Пароль = Сотрудник.Пароль;
	КонецЕсли;

	ПользовательИБ.Роли.Очистить();
	ПользовательИБ.Роли.Добавить(РольПоУровнюДоступа(Сотрудник.УровеньДоступа));

	Попытка
		ПользовательИБ.Записать();
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("Не удалось записать пользователя информационной базы: %1",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецПопытки;

	Сотрудник.ИдентификаторПользователяИБ = ПользовательИБ.УникальныйИдентификатор;
	// Пароль хранится только в информационной базе пользователей, в справочнике его не оставляем.
	Сотрудник.Пароль = "";

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьСлужебногоАдминистратора()

	ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
	ПользовательИБ.Имя = "Администратор";
	ПользовательИБ.ПолноеИмя = "Администратор";
	ПользовательИБ.АутентификацияСтандартная = Истина;
	// Служебный пользователь: не виден в списке пользователей при авторизации.
	ПользовательИБ.ПоказыватьВСпискеВыбора = Ложь;
	ПользовательИБ.Роли.Добавить(Метаданные.Роли.Администратор);
	ПользовательИБ.Записать();

КонецПроцедуры

Функция РольПоУровнюДоступа(УровеньДоступа)

	Если УровеньДоступа = Перечисления.УровниДоступа.Администратор Тогда
		Возврат Метаданные.Роли.Администратор;
	ИначеЕсли УровеньДоступа = Перечисления.УровниДоступа.МенеджерЗаказов Тогда
		Возврат Метаданные.Роли.МенеджерЗаказов;
	ИначеЕсли УровеньДоступа = Перечисления.УровниДоступа.Технолог Тогда
		Возврат Метаданные.Роли.Технолог;
	ИначеЕсли УровеньДоступа = Перечисления.УровниДоступа.МастерПроизводственнойСмены Тогда
		Возврат Метаданные.Роли.МастерПроизводственнойСмены;
	ИначеЕсли УровеньДоступа = Перечисления.УровниДоступа.Бухгалтер Тогда
		Возврат Метаданные.Роли.Бухгалтер;
	ИначеЕсли УровеньДоступа = Перечисления.УровниДоступа.Экспедитор Тогда
		Возврат Метаданные.Роли.Экспедитор;
	КонецЕсли;

	ВызватьИсключение НСтр("ru = 'Не указан уровень доступа сотрудника.'");

КонецФункции

#КонецОбласти
